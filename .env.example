PORT=3000
BOT_TOKEN=
PUBLIC_URL=https://your-domain.example
ADMIN_IDS=
ADMIN_CHAT_ID=
DATA_KEY=

# Seller marketplace
# Store commission charged on seller orders (percent)
SELLER_COMMISSION_PERCENT=5
# Maximum quantity allowed in one order. Seller hold is always fixed at 72 hours.
MAX_ITEMS_PER_ORDER=199999

CRYPTOPAY_TOKEN=
HELEKET_MERCHANT_ID=
HELEKET_PAYMENT_API_KEY=

# LZT Market: add these values only in your hosting environment variables
LZT_CLIENT_ID=
LZT_CLIENT_SECRET=
LZT_MERCHANT_ID=
LZT_MERCHANT_KEY=
LZT_MERCHANT_TOKEN=
# Usually RUB
LZT_CURRENCY=RUB
# Cashera SBP (server-side only)
# PUBLIC_URL above must be a public HTTPS origin; callback is PUBLIC_URL/webhooks/cashera
CASHERA_API_KEY=
CASHERA_API_SECRET=
